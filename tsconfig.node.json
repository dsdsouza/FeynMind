{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "vitest.live.config.mts",
    "vitest.models.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  }
}
