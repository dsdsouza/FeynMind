{
  "name": "feynmind",
  "productName": "FeynMind",
  "version": "0.2.0",
  "description": "Local-first adaptive tutor built from your course materials",
  "license": "MIT",
  "author": "FeynMind contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/dsdsouza/FeynMind.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:live": "node scripts/run-vitest.mjs --live run --config vitest.live.config.mts",
    "test:models": "node scripts/run-vitest.mjs run --config vitest.models.config.mts",
    "bench:ingest": "node scripts/bench-ingest.mjs",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "npm run build && electron-builder --publish never",
    "check:deps": "node scripts/check-runtime-deps.mjs",
    "smoke": "node scripts/smoke-packaged.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.118",
    "@huggingface/tokenizers": "0.2.0",
    "@napi-rs/canvas": "1.1.1",
    "@tesseract.js-data/eng": "1.0.0",
    "ai": "7.0.170",
    "better-sqlite3": "13.1.1",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "onnxruntime-node": "1.31.1",
    "pdfjs-dist": "6.5.438",
    "sqlite-vec": "0.1.9",
    "tesseract.js": "7.0.0",
    "ts-fsrs": "5.4.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "katex": "0.19.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-math": "6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "katex": "0.19.1"
  }
}
